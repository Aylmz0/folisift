# Rust build output.
/target/

# Generated guide PDFs are local artifacts, not repository content.
output/*.pdf
output/**/*.pdf

# Generated style previews are not release outputs.
output/style-preview-*.pdf

# Local offline exam copy; regenerate with `make offline-exam`.
output/offline-exam/

# Downloaded semantic model assets; release packaging copies them.
models/

# Local graphify knowledge graph; rebuild with `graphify update .`.
graphify-out/
guides/*/data/topics.json
