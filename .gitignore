# Personal/course PDFs are local inputs; never commit them.
sources/*.pdf
sources/**/*.pdf

.DS_Store

# Generated source text, layout blocks and page screenshots.
guides/*/data/blocks/
guides/*/data/document-links.json
guides/*/data/document-links.md
guides/*/data/document-graph.json
guides/*/data/incremental-sections.json
data/blocks/
guides/*/data/cache/
data/pages/
data/visual/
guides/*/data/pages/
data/cache/
data/pages/
data/visual/

# Temporary LaTeX/Office files.
*.aux
*.log
